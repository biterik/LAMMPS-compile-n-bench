+------------------------------------------------------------------------- */
+
+#include "compute_sites_voronoi_kokkos.h"
+
+#include "atom_kokkos.h"
+#include "atom_masks.h"
+
+using namespace LAMMPS_NS;
+
+/* ---------------------------------------------------------------------- */
+
+ComputeSitesVoronoiKokkos::ComputeSitesVoronoiKokkos(LAMMPS *lmp, int narg, char **arg) :
+    ComputeSitesVoronoi(lmp, narg, arg)
+{
+  kokkosable = 1;
+  execution_space = Host;
+  datamask_read = EMPTY_MASK;
+  datamask_modify = EMPTY_MASK;
+}
+
+/* ----------------------------------------------------------------------
+   the tessellation, clustering and all site criteria run on the host
+   (Voro++ is a serial CPU library); the only Kokkos-specific step is
+   pulling the live atom data off the device before the host reads it
+------------------------------------------------------------------------- */
+
+void ComputeSitesVoronoiKokkos::compute_local()
+{
+  atomKK->sync(Host, X_MASK | TYPE_MASK | MASK_MASK | TAG_MASK);
+  ComputeSitesVoronoi::compute_local();
+}
diff --git a/src/KOKKOS/compute_sites_voronoi_kokkos.h b/src/KOKKOS/compute_sites_voronoi_kokkos.h
