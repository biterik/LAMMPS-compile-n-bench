+/* ----------------------------------------------------------------------
+   check keyword: per-block state-consistency verification (debug aid for
+   parallel investigations; one extra full-energy evaluation per block).
+   errors out at the FIRST inconsistent block, so a parallel bookkeeping
+   bug is pinpointed to the block where it happens instead of surfacing
+   later as silently wrong statistics
+------------------------------------------------------------------------- */
+
+void FixMCSites::run_consistency_checks(bigint nocc)
+{
+  sync_atoms_host();    // checks read x/mask/type on the host (kk subclass)
+
+  // 1. global atom count: natoms must equal the sum of nlocal over ranks
+  //    (catches trial-atom cleanup removing the wrong number of atoms)
+
+  bigint nlocal_bigint = atom->nlocal;
+  bigint natoms_actual;
+  MPI_Allreduce(&nlocal_bigint, &natoms_actual, 1, MPI_LMP_BIGINT, MPI_SUM, world);
+  if (natoms_actual != atom->natoms)
+    error->all(FLERR,
+               "Fix mc/sites {} consistency check failed on step {}: sum of nlocal {} "
+               "!= natoms {}",
+               id, update->ntimestep, natoms_actual, atom->natoms);
+
+  // 2. species accounting: atoms of the species type (in group/region) must
+  //    match the catalogue occupancy (catches a rejected trial atom leaking
+  //    into the system or a host atom deleted in its place)
+
+  double **x = atom->x;
+  int *mask = atom->mask;
+  int *type = atom->type;
+  bigint nsp_local = 0;
+  for (int i = 0; i < atom->nlocal; i++) {
+    if (!(mask[i] & groupbit)) continue;
+    if (type[i] != mcs_type) continue;
+    if (region && !region->match(x[i][0], x[i][1], x[i][2])) continue;
+    nsp_local++;
+  }
+  bigint nsp;
+  MPI_Allreduce(&nsp_local, &nsp, 1, MPI_LMP_BIGINT, MPI_SUM, world);
+  if (nsp != nocc)
+    error->all(FLERR,
+               "Fix mc/sites {} consistency check failed on step {}: {} species atoms "
+               "vs {} occupied catalogue entries",
+               id, update->ntimestep, nsp, nocc);
+
+  // 3. energy bookkeeping (gc mode): energy_stored must equal a fresh full
+  //    evaluation (catches an imperfect reject-restore desynchronizing the
+  //    Metropolis reference energy)
+
+  if (mode == MODE_GC) {
+    double e_verify = energy_full();
+    double etol = MAX(CHECK_ETOL_ABS, CHECK_ETOL_REL * fabs(e_verify));
+    if (fabs(e_verify - energy_stored) > etol)
+      error->all(FLERR,
+                 "Fix mc/sites {} consistency check failed on step {}: stored energy "
+                 "{:.10} vs recomputed {:.10} (tol {:.3})",
+                 id, update->ntimestep, energy_stored, e_verify, etol);
+  }
+}
