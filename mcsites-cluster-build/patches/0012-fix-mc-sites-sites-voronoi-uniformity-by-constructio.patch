+                     id, update->ntimestep, catalog[i].x[0], catalog[i].x[1], catalog[i].x[2],
+                     ownall[i]);
+      }
+      catalog[nkeep++] = catalog[i];
+    }
+    ncatalog = nkeep;
+    memory->destroy(own);
+    memory->destroy(ownall);
+    if (ndropped && !noowner_warned && comm->me == 0) {
+      noowner_warned = 1;
+      error->warning(FLERR,
+                     "Fix mc/sites {} on step {}: dropped {} catalogue site(s) no rank owns "
+                     "(outside the non-periodic box beyond the face tolerance); further "
+                     "drops will not be reported",
+                     id, update->ntimestep, ndropped);
+    }
+  }
