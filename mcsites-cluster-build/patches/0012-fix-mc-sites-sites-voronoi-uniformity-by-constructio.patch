-  seed = (int) list[n++];
-  random_unequal->reset(seed);
+
+  // random_unequal is per-rank by construction (seed + comm->me at fix
+  // creation: it draws the inserted-atom velocities on the owning rank, so
+  // ranks must NOT share a stream).  the restart file carries rank 0's
+  // state; restoring it verbatim on every rank would silently collapse all
+  // ranks onto one stream after a resume.  re-derive a distinct stream per
+  // rank from the saved state, folded into RanPark's valid seed range
+
+  int state_unequal = (int) list[n++];
+  int seed_unequal = (int) ((((bigint) state_unequal - 1 + comm->me) % (bigint) 2147483646) + 1);
+  random_unequal->reset(seed_unequal);
   next_reneighbor = (bigint) ubuf(list[n++]).i;
   nattempts = list[n++];
   ninsert_acc = list[n++];
