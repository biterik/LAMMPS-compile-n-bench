+  // every rank evaluates the equal-style variables, but the Metropolis test
+  // compares a synchronized RNG stream against exp(-beta*(dU -/+ mu)): if mu
+  // or temp differed across ranks by even one ulp, ranks could take opposite
+  // accept/reject branches and desynchronize natoms itself.  rank 0's values
+  // are therefore made authoritative (uniformity by construction)
+
+  if (temp_var >= 0) temp = input->variable->compute_equal(temp_var);
   if (mu_var >= 0) mu = input->variable->compute_equal(mu_var);
+  if (temp_var >= 0 || mu_var >= 0) {
+    double params[2] = {temp, mu};
+    MPI_Bcast(params, 2, MPI_DOUBLE, 0, world);
+    temp = params[0];
+    mu = params[1];
+  }
+  if (temp <= 0.0)
+    error->all(FLERR, "Fix mc/sites temperature variable gave {}, must be > 0.0", temp);
   beta = 1.0 / (force->boltz * temp);
   sigma = sqrt(force->boltz * temp * tfac_insert / gas_mass / force->mvv2e);
 
@@ -915,11 +982,42 @@ void FixMCSites::report_count_forensics(bigint natoms_actual)
 int FixMCSites::site_owner_flag(double *coord)
 {
   domain->remap(coord);
+
+  // non-periodic dims: remap does not touch them, so a site sitting ON a
+  // box face up to fp rounding (or inside the sites compute's nudge-wide
+  // emission overhang below the low face) would be claimed by NO rank:
+  // natoms would then be updated with no atom created/removed.  Clamp
+  // face-noise onto the face -- one ulp inside at the high face, so the
+  // top rank's half-open [sublo,subhi) test claims it -- and leave sites
+  // beyond OWNER_FACE_TOL unowned (build_catalog drops those).
+
   if (triclinic) {
     double lamda[3];
     domain->x2lamda(coord, lamda);
-    return (lamda[0] >= sublo[0] && lamda[0] < subhi[0] && lamda[1] >= sublo[1] &&
-            lamda[1] < subhi[1] && lamda[2] >= sublo[2] && lamda[2] < subhi[2]);
+    int clamped = 0;
+    for (int d = 0; d < 3; d++) {
+      if (domain->periodicity[d]) continue;
+      if (lamda[d] < 0.0 && lamda[d] >= -OWNER_FACE_TOL) {
+        lamda[d] = 0.0;
+        clamped = 1;
+      } else if (lamda[d] >= 1.0 && lamda[d] <= 1.0 + OWNER_FACE_TOL) {
+        lamda[d] = std::nextafter(1.0, 0.0);
+        clamped = 1;
+      }
+    }
+    int flag = (lamda[0] >= sublo[0] && lamda[0] < subhi[0] && lamda[1] >= sublo[1] &&
+                lamda[1] < subhi[1] && lamda[2] >= sublo[2] && lamda[2] < subhi[2]);
+    if (clamped && flag) domain->lamda2x(lamda, coord);
+    return flag;
+  }
+
+  for (int d = 0; d < 3; d++) {
+    if (domain->periodicity[d]) continue;
+    double tol = OWNER_FACE_TOL * domain->prd[d];
+    if (coord[d] < domain->boxlo[d] && coord[d] >= domain->boxlo[d] - tol)
+      coord[d] = domain->boxlo[d];
+    else if (coord[d] >= domain->boxhi[d] && coord[d] <= domain->boxhi[d] + tol)
+      coord[d] = std::nextafter(domain->boxhi[d], domain->boxlo[d]);
   }
   return (coord[0] >= sublo[0] && coord[0] < subhi[0] && coord[1] >= sublo[1] &&
           coord[1] < subhi[1] && coord[2] >= sublo[2] && coord[2] < subhi[2]);
