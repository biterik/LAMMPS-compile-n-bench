   memory->destroy(occall);
+
+  // ownership validation of the frozen catalogue: every empty entry must be
+  // claimed by exactly one rank under site_owner_flag, or an insertion trial
+  // there would update natoms with no atom created.  entries no rank owns
+  // (a site file position outside a non-periodic box, or any emission /
+  // ownership mismatch beyond the face tolerance) are dropped HERE,
+  // identically on all ranks, so they never enter the proposal set; the
+  // per-trial owner assertion then guards the invariant.  occupied entries
+  // are real atoms resolved through the atom map -- owned by construction
+
+  if (ncatalog > 0) {
+    int *own, *ownall;
+    memory->create(own, ncatalog, "mc/sites:own");
+    memory->create(ownall, ncatalog, "mc/sites:ownall");
+    for (int i = 0; i < ncatalog; i++) {
+      own[i] = 0;
+      if (catalog[i].tag == 0) {
+        double coord[3] = {catalog[i].x[0], catalog[i].x[1], catalog[i].x[2]};
+        own[i] = site_owner_flag(coord);
+      }
+    }
+    MPI_Allreduce(own, ownall, ncatalog, MPI_INT, MPI_SUM, world);
+    int nkeep = 0, ndropped = 0;
+    for (int i = 0; i < ncatalog; i++) {
+      if (catalog[i].tag == 0) {
+        if (ownall[i] == 0) {
+          ndropped++;
+          continue;
+        }
+        if (ownall[i] > 1)
+          error->all(FLERR,
+                     "Fix mc/sites {} on step {}: catalogue site ({:.17e} {:.17e} {:.17e}) "
