+FixStyle(mc/sites/kk,FixMCSitesKokkos);
+FixStyle(mc/sites/kk/device,FixMCSitesKokkos);
+FixStyle(mc/sites/kk/host,FixMCSitesKokkos);
+// clang-format on
+#else
+
+#ifndef LMP_FIX_MC_SITES_KOKKOS_H
+#define LMP_FIX_MC_SITES_KOKKOS_H
+
+#include "fix_mc_sites.h"
+
+namespace LAMMPS_NS {
+
+class FixMCSitesKokkos : public FixMCSites {
+ public:
+  FixMCSitesKokkos(class LAMMPS *, int, char **);
+
+ protected:
+  void sync_atoms_host() override;
+  void mark_atoms_modified() override;
+};
+
+}    // namespace LAMMPS_NS
