+/* ----------------------------------------------------------------------
+   Contributing author: Erik Bitzek (erik.bitzek@googlemail.com)
+
+   Kokkos-aware variant of fix mc/sites.  The MC bookkeeping (catalogue,
+   proposals, acceptance) is inherently serial and stays on the host; the
+   per-trial full energy evaluations run through the Kokkos pair styles
+   on the device.  All this subclass adds are the device<->host coherence
+   points: the base class calls sync_atoms_host() before every host read
+   of atom arrays and mark_atoms_modified() after every host-side change
+   (insert / delete / restore / velocities / forces / tags / nlocal), so
+   the device rebuilds its atom set before each energy evaluation.
+------------------------------------------------------------------------- */
+
+#include "fix_mc_sites_kokkos.h"
+
+#include "atom_kokkos.h"
+#include "atom_masks.h"
+
+using namespace LAMMPS_NS;
+
+/* ---------------------------------------------------------------------- */
+
+FixMCSitesKokkos::FixMCSitesKokkos(LAMMPS *lmp, int narg, char **arg) : FixMCSites(lmp, narg, arg)
+{
+  kokkosable = 1;
+  execution_space = Host;
+  datamask_read = EMPTY_MASK;
+  datamask_modify = EMPTY_MASK;
+}
+
+/* ----------------------------------------------------------------------
+   pull everything the host-side MC mechanics may read (positions, types,
+   masks, tags, velocities, forces, images, charges) off the device; a
+   full-mask sync is cheap when nothing is stale and correct everywhere
+------------------------------------------------------------------------- */
+
+void FixMCSitesKokkos::sync_atoms_host()
+{
+  atomKK->sync(Host, ALL_MASK);
+}
+
+/* ----------------------------------------------------------------------
+   tell the device the host changed the atom set; the next Kokkos consumer
+   (comm, neighbor build, pair compute) re-syncs before it runs
+------------------------------------------------------------------------- */
+
+void FixMCSitesKokkos::mark_atoms_modified()
+{
+  atomKK->modified(Host, ALL_MASK);
+}
