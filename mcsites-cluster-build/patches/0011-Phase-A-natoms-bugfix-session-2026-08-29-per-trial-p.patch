+/* ----------------------------------------------------------------------
+   invariant: every trial must have exactly one executing rank.  0 owners
+   on insertion means a catalogue site outside every subdomain (natoms
+   would be incremented with no atom created); 0 owners on deletion means
+   a tag no rank resolves (natoms decremented with no atom removed); 2+
+   owners double-execute the local mechanics.  each is silent count
+   corruption that check #1 would only catch at block end, without the
+   site identity -- so this is asserted unconditionally per trial (one int
+   allreduce; the trial already pays a full energy evaluation)
+------------------------------------------------------------------------- */
+
+void FixMCSites::assert_site_owner_count(int proc_flag, int idx, const char *action)
+{
+  int nowner;
+  MPI_Allreduce(&proc_flag, &nowner, 1, MPI_INT, MPI_SUM, world);
+  if (nowner == 1) return;
+  error->all(FLERR,
+             "Fix mc/sites {} {} on step {}: {} ranks own the trial (must be exactly 1). "
+             "Catalogue entry {} of {}: site ({:.17e} {:.17e} {:.17e}), tag {}, box "
+             "({:.17e} {:.17e} {:.17e}) to ({:.17e} {:.17e} {:.17e}), periodicity ({} {} {})",
+             id, action, update->ntimestep, nowner, idx, ncatalog, catalog[idx].x[0],
+             catalog[idx].x[1], catalog[idx].x[2], catalog[idx].tag, domain->boxlo[0],
+             domain->boxlo[1], domain->boxlo[2], domain->boxhi[0], domain->boxhi[1],
+             domain->boxhi[2], domain->periodicity[0], domain->periodicity[1],
+             domain->periodicity[2]);
+}
+
+/* ----------------------------------------------------------------------
+   check keyword: the accept/reject decision and the state it derives from
+   must be bit-identical on all ranks; a divergence (e.g. an equal-style
+   mu/temp variable evaluating differently across ranks) makes ranks take
+   different branches and desynchronizes natoms itself
+------------------------------------------------------------------------- */
+
+void FixMCSites::assert_rank_uniform_decision(int accept, double energy_after, double energy_before,
+                                              const char *action)
+{
+  double state[6], smin[6], smax[6];
+  state[0] = (double) accept;
+  state[1] = (double) atom->natoms;
+  state[2] = mu;
+  state[3] = beta;
+  state[4] = energy_after;
+  state[5] = energy_before;
+  MPI_Allreduce(state, smin, 6, MPI_DOUBLE, MPI_MIN, world);
+  MPI_Allreduce(state, smax, 6, MPI_DOUBLE, MPI_MAX, world);
+  int uniform = 1;
+  for (int k = 0; k < 6; k++)
+    if (smin[k] != smax[k]) uniform = 0;
+  if (uniform) return;
+  error->all(FLERR,
+             "Fix mc/sites {} check on step {}: rank-divergent {} trial: accept {}..{}, "
+             "natoms {:.17e}..{:.17e}, mu {:.17e}..{:.17e}, beta {:.17e}..{:.17e}, "
+             "energy_after {:.17e}..{:.17e}, energy_before {:.17e}..{:.17e}",
+             id, update->ntimestep, action, (int) smin[0], (int) smax[0], smin[1], smax[1], smin[2],
+             smax[2], smin[3], smax[3], smin[4], smax[4], smin[5], smax[5]);
+}
+
+/* ----------------------------------------------------------------------
+   abort-path forensics for a count mismatch: name what is identifiable --
+   occupied catalogue entries whose tag no rank (or 2+ ranks) resolves to
+   an owned atom, and duplicated tags across ranks.  cost is irrelevant
+   (the run is about to error out)
+------------------------------------------------------------------------- */
+
+void FixMCSites::report_count_forensics(bigint natoms_actual)
+{
+  // occupied catalogue entries vs the atom map
+
+  int nmissing = 0, nmulti = 0;
+  std::string detail;
+  if (ncatalog > 0) {
+    int *own = new int[ncatalog];
+    int *ownall = new int[ncatalog];
+    for (int i = 0; i < ncatalog; i++) {
+      own[i] = 0;
+      if (catalog[i].tag > 0) {
+        int m = atom->map(catalog[i].tag);
+        if (m >= 0 && m < atom->nlocal) own[i] = 1;
+      }
+    }
+    MPI_Allreduce(own, ownall, ncatalog, MPI_INT, MPI_SUM, world);
+    for (int i = 0; i < ncatalog; i++) {
+      if (catalog[i].tag <= 0) continue;
+      if (ownall[i] == 1) continue;
+      if (ownall[i] == 0)
+        nmissing++;
+      else
+        nmulti++;
+      if (nmissing + nmulti <= 8)
+        detail += fmt::format("  catalogue entry {}: tag {} at ({:.6} {:.6} {:.6}) owned by "
+                              "{} ranks\n",
+                              i, catalog[i].tag, catalog[i].x[0], catalog[i].x[1], catalog[i].x[2],
+                              ownall[i]);
+    }
+    delete[] own;
+    delete[] ownall;
+  }
+
+  // duplicate tags across all ranks (gather to rank 0)
+
+  int nprocs = comm->nprocs;
+  int nlocal = atom->nlocal;
+  int *counts = nullptr, *displs = nullptr;
+  tagint *alltags = nullptr;
+  if (comm->me == 0) {
+    counts = new int[nprocs];
+    displs = new int[nprocs];
+  }
+  MPI_Gather(&nlocal, 1, MPI_INT, counts, 1, MPI_INT, 0, world);
+  bigint ntotal = 0;
+  if (comm->me == 0) {
+    for (int p = 0; p < nprocs; p++) {
+      displs[p] = (int) ntotal;
+      ntotal += counts[p];
+    }
+    alltags = new tagint[MAX(ntotal, (bigint) 1)];
+  }
+  MPI_Gatherv(atom->tag, nlocal, MPI_LMP_TAGINT, alltags, counts, displs, MPI_LMP_TAGINT, 0, world);
+  bigint ndup = 0;
+  if (comm->me == 0) {
+    std::sort(alltags, alltags + ntotal);
+    for (bigint i = 1; i < ntotal; i++)
+      if (alltags[i] == alltags[i - 1]) ndup++;
+    delete[] alltags;
+    delete[] counts;
+    delete[] displs;
+  }
+  MPI_Bcast(&ndup, 1, MPI_LMP_BIGINT, 0, world);
+
+  if (comm->me == 0)
+    utils::logmesg(lmp,
+                   "Fix mc/sites {} count-mismatch forensics on step {}: sum of nlocal {}, "
+                   "natoms {}, deficit {}; {} occupied catalogue entries with no owning rank, "
+                   "{} with multiple owners; {} duplicated atom tags across ranks\n{}",
+                   id, update->ntimestep, natoms_actual, atom->natoms, atom->natoms - natoms_actual,
+                   nmissing, nmulti, ndup, detail);
+}
+
 /* ----------------------------------------------------------------------
    which rank owns a position: remap into the box, test the subdomain
    (fix gcmc pattern); returns 1 on exactly one rank
@@ -767,6 +961,7 @@ void FixMCSites::attempt_insertion(int idx)
   double energy_before = energy_stored;
   double coord[3] = {catalog[idx].x[0], catalog[idx].x[1], catalog[idx].x[2]};
   int proc_flag = site_owner_flag(coord);
