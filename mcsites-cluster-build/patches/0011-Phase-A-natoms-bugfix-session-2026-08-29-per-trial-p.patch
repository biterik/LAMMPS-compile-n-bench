   sync_atoms_host();
   if (proc_flag) {
@@ -795,8 +990,11 @@ void FixMCSites::attempt_insertion(int idx)
 
   double energy_after = energy_full();
 
-  if (energy_after < MAXENERGYTEST &&
-      random_equal->uniform() < exp(-beta * (energy_after - energy_before - mu))) {
+  int accept = (energy_after < MAXENERGYTEST &&
+                random_equal->uniform() < exp(-beta * (energy_after - energy_before - mu)));
+  if (check_flag) assert_rank_uniform_decision(accept, energy_after, energy_before, "insertion");
+
+  if (accept) {
     ninsert_acc += 1.0;
     energy_stored = energy_after;
     catalog[idx].tag = newtag;
@@ -828,6 +1026,7 @@ void FixMCSites::attempt_deletion(int idx)
   tagint dtag = catalog[idx].tag;
   int m = atom->map(dtag);
   int proc_flag = (m >= 0 && m < atom->nlocal);
+  assert_site_owner_count(proc_flag, idx, "deletion");
 
   sync_atoms_host();
   if (proc_flag) {
@@ -856,7 +1055,10 @@ void FixMCSites::attempt_deletion(int idx)
 
   double energy_after = energy_full();
 
-  if (random_equal->uniform() < exp(-beta * (energy_after - energy_before + mu))) {
+  int accept = (random_equal->uniform() < exp(-beta * (energy_after - energy_before + mu)));
+  if (check_flag) assert_rank_uniform_decision(accept, energy_after, energy_before, "deletion");
+
+  if (accept) {
     ndelete_acc += 1.0;
     energy_stored = energy_after;
     // entry stays in the catalogue as empty at the deleted atom's position:
@@ -927,6 +1129,7 @@ void FixMCSites::run_source_mode()
 
     double coord[3] = {catalog[idx].x[0], catalog[idx].x[1], catalog[idx].x[2]};
     int proc_flag = site_owner_flag(coord);
+    assert_site_owner_count(proc_flag, idx, "source insertion");
 
     sync_atoms_host();
     if (proc_flag) {
@@ -1003,6 +1206,12 @@ double FixMCSites::energy_full()
   update->eflag_global = update->ntimestep;
   double energy = c_pe->compute_scalar();
 
+  // alternating sign so the offset does NOT cancel in dU = E_after - E_before:
+  // emulates a per-call-varying cross-rank reduction discrepancy
+
+  if (debug_perturb_rank >= 0 && comm->me == debug_perturb_rank)
+    energy += 0.05 * ((++debug_perturb_ncalls) & 1);
+
   // leave the host copy of the atom data current for the caller's next
   // host-side trial mechanics
 
diff --git a/src/MC/fix_mc_sites.h b/src/MC/fix_mc_sites.h
index edc6fdc..9157e5a 100644
--- a/src/MC/fix_mc_sites.h
+++ b/src/MC/fix_mc_sites.h
@@ -104,6 +104,11 @@ class FixMCSites : public Fix {
   virtual void run_source_mode();
   virtual double energy_full();
   void run_consistency_checks(bigint);
+  void assert_site_owner_count(int, int, const char *);
+  void assert_rank_uniform_decision(int, double, double, const char *);
+  int debug_perturb_rank;         // test hook: rank whose energy_full is offset (-1 = off)
+  bigint debug_perturb_ncalls;    // test hook: energy_full call counter
+  void report_count_forensics(bigint);
   int site_owner_flag(double *);
   tagint global_new_tag(int);
 
